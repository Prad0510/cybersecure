# CyberGuard Environment Configuration

# Application
APP_NAME=CyberGuard
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=cyberguard-super-secret-key-change-in-production-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (Default: local SQLite for portable zero-setup operation, easily switch to PostgreSQL)
DATABASE_URL=sqlite:///./cyberguard.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/cyberguard

# ML & Models
ACTIVE_MODEL_VERSION=CB-RO-001
DEVICE=cpu
EMBEDDING_DIM=100
PCA_COMPONENTS=30

# File Storage
UPLOAD_DIR=./uploads
ARTIFACTS_DIR=./artifacts
REPORTS_DIR=./artifacts/reports

# Admin Initial Seed
ADMIN_EMAIL=admin@cyberguard.ai
ADMIN_PASSWORD=AdminSecure2026!
ADMIN_NAME="System Administrator"
